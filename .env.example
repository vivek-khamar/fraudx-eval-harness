# Copy to .env and fill in real values. Never commit .env.

# Base URL of the FraudX gateway environment to evaluate (e.g. https://gateway.qa.fraudx.eyelevel.ai).
FRAUDX_ENDPOINT_URI=https://gateway.fraudx.eyelevel.ai

# Login credentials for FRAUDX_ENDPOINT_URI. The provider logs in fresh on every eval run.
FRAUDX_LOGIN_EMAIL=
FRAUDX_LOGIN_PASSWORD=

# Which provider grades the llm-rubric assertion, e.g. "anthropic:messages:claude-sonnet-4-5"
# or "openai:chat:gpt-4o". Required — no default. That provider's own API key must also be
# set (e.g. ANTHROPIC_API_KEY or OPENAI_API_KEY).
GRADER_PROVIDER=openai:gpt-5.1

# Used by promptfoo's llm-rubric assertion to grade report/QA accuracy. Pinned explicitly in
# promptfooconfig.yaml's defaultTest.options.provider, so this key is always the one used to grade.
OPENAI_API_KEY=

# Credentials and bucket name for reading the S3 chunk-grounding file (chunk-grounding
# data for citations) — separate from the FraudX gateway credentials above.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=fraudx-prod-claim-processor

# Required for `npm run eval`. The id of an existing, already-processed bucket
# whose own report becomes the ground truth this run is validated against.
SOURCE_BUCKET_ID=

# Required for `npm run eval`. A claim name can't be reused on the real
# platform, and the ingestion/processing model is a per-run choice — all three
# are resolved live by scripts/build-tests-vars.js (run automatically via the
# preeval hook), which fails fast with a clear error if any is blank.
CLAIM_NAME=
# Exact displayName from the FraudX model catalog (e.g. "openai-gpt-5.4") — not the bare
# model name, which collides across providers.
INGESTION_MODEL_NAME=
PROCESSING_MODEL_NAME=

# Optional: override the per-request HTTP timeout in ms for FraudX gateway calls. Defaults to 900000 (15 minutes).
FRAUDX_HTTP_TIMEOUT_MS=900000

# Optional: override how often/how long to poll for an uploaded document to finish GX processing
# (skipGxProcess:false means this now covers real per-file OCR/embedding, not just registration).
# How long this takes depends on document size, not just document count — larger documents have
# been observed to exceed a 10-minute window, so this defaults to 1800000 (30 minutes). Raise it
# further if you're evaluating especially large documents.
FRAUDX_UPLOAD_POLL_INTERVAL_MS=2000
FRAUDX_UPLOAD_POLL_TIMEOUT_MS=1800000

# Optional: override how often/how long to poll for claim processing to finish. Defaults to
# 3600000 (60 minutes) — the real platform has been observed to need more than 15 minutes here.
FRAUDX_PROCESSING_POLL_INTERVAL_MS=5000
FRAUDX_PROCESSING_POLL_TIMEOUT_MS=3600000
