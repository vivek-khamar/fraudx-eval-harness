# Copy to .env and fill in real values. Never commit .env.

# Base URL of the FraudX gateway environment to evaluate (e.g. https://gateway.qa.fraudx.eyelevel.ai).
FRAUDX_TEST_ENDPOINT=https://gateway.qa.fraudx.eyelevel.ai

# Login credentials for FRAUDX_TEST_ENDPOINT. The provider logs in fresh on every eval run.
FRAUDX_LOGIN_EMAIL=
FRAUDX_LOGIN_PASSWORD=

# Used by promptfoo's llm-rubric assertion to grade report/QA accuracy. Pinned explicitly in
# promptfooconfig.yaml's defaultTest.options.provider, so this key is always the one used to grade.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: override the ingestion time budget in ms. Defaults to 120000 (2 minutes).
INGEST_BUDGET_MS=120000

# Optional: override the end-to-end claim processing budget in ms. Defaults to 600000 (10 minutes), per the FraudX SLA.
CLAIM_BUDGET_MS=600000

# Optional: override the per-request HTTP timeout in ms for FraudX gateway calls. Defaults to 900000 (15 minutes).
FRAUDX_HTTP_TIMEOUT_MS=900000

# Optional: override how often/how long to poll for an uploaded document to finish registering.
FRAUDX_UPLOAD_POLL_INTERVAL_MS=2000
FRAUDX_UPLOAD_POLL_TIMEOUT_MS=120000

# Optional: override how often/how long to poll for claim processing to finish.
FRAUDX_PROCESSING_POLL_INTERVAL_MS=5000
FRAUDX_PROCESSING_POLL_TIMEOUT_MS=900000
