# Copy to .env and fill in real values. Never commit .env.

# Base URL of the FraudX platform environment to evaluate (staging or production).
FRAUDX_TEST_ENDPOINT=https://staging.fraudx.internal

# Used by promptfoo's llm-rubric assertion to grade report/QA accuracy.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: override the ingestion time budget in ms. Defaults to 120000 (2 minutes).
INGEST_BUDGET_MS=120000

# Optional: override the end-to-end claim processing budget in ms. Defaults to 600000 (10 minutes), per the FraudX SLA.
CLAIM_BUDGET_MS=600000

# Optional: override the per-request HTTP timeout in ms for the ingest/process calls. Defaults to 900000 (15 minutes).
FRAUDX_HTTP_TIMEOUT_MS=900000
